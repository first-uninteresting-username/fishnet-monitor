{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],
  // Every update merges itself once CI is green on the PR's last commit, majors
  // included: CI's smoke test runs the real image, so a break shows there. The
  // merge to main publishes a new :edge, which redeploys the orchard deployment.
  // Renovate merges by itself (not GitHub's auto-merge), because main has no
  // branch protection and GitHub would merge without waiting for CI. Without
  // any check on the commit Renovate doesn't merge, so a PR CI never ran on
  // stays open.
  automerge: true,
  platformAutomerge: false,
  // Also refresh Cargo.lock's indirect dependencies once a week.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  // .github/workflows/refresh-vendored-frontend.yml commits on top of Renovate's
  // PRs; without this Renovate would treat them as edited and stop updating them.
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],
  customManagers: [
    {
      // frontend/vendor.lock: one line per vendored file,
      //   file  package  version  path-in-package  sha256
      customType: 'regex',
      description: 'Frontend libraries vendored by scripts/vendor-frontend.sh',
      managerFilePatterns: ['/^frontend/vendor\\.lock$/'],
      matchStrings: [
        '^[\\w.-]+[ \\t]+(?<depName>[@\\w./-]+)[ \\t]+(?<currentValue>\\d[\\w.+-]*)[ \\t]+\\S+[ \\t]+(?:[0-9a-f]{64}|-)[ \\t]*$',
      ],
      datasourceTemplate: 'npm',
      versioningTemplate: 'npm',
    },
  ],
}
